# Copy this file to .env and change the values. Never commit .env.
PORT=3000
DATABASE_PATH=./data/app.db

# --- Production ---------------------------------------------------------
# NODE_ENV=production        # turns on HTTPS redirect, HSTS, Secure cookies
# APP_ORIGIN=https://login.example.com
# TRUST_PROXY=1              # if a proxy/host (Caddy, nginx, Render...) handles HTTPS

# --- Optional: HTTPS on your own computer (see README) -------------------
# HTTPS_KEY_FILE=./certs/localhost-key.pem
# HTTPS_CERT_FILE=./certs/localhost.pem

# --- Email ---------------------------------------------------------------
# On your computer the defaults send everything to Mailpit (see README).
# In production, with Resend and the domain mail.kenyachan.dev verified:
# EMAIL_FROM=Kenya Chan <no-reply@mail.kenyachan.dev>
# SMTP_URL=smtps://resend:re_YOUR_API_KEY@smtp.resend.com:465
